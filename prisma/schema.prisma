generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  INSTAGRAM
  // FACEBOOK, TIKTOK, YOUTUBE reserved for later phases (Level 2 clusters
  // not yet built) -- listed here only so the schema doesn't need a
  // migration just to add the enum value when those phases start.
  FACEBOOK
  TIKTOK
  YOUTUBE
}

enum MediaType {
  IMAGE
  VIDEO // sourced either from a manually-pasted URL or generated by the
  // separate Video Agent product and imported via videoAgentProductionId
}

enum SocialPostStatus {
  DRAFT               // Content Creation Agent has produced a caption, not yet compliance-checked
  COMPLIANCE_REJECTED  // Compliance Agent blocked it -- never reaches the approval queue
  PENDING_APPROVAL     // passed Compliance, waiting on a human in /approvals
  APPROVED             // human approved, Orchestrator is publishing (or about to)
  REJECTED             // human explicitly rejected
  PUBLISHED            // live on the real platform
  PUBLISH_FAILED       // approved, but the platform API call failed
}

// One Meta app can hold multiple connected accounts eventually (Phase 4:
// multi-account/agency views); v1 has exactly one row.
model SocialAccount {
  id                 String   @id @default(cuid())
  platform           Platform
  externalAccountId  String   // Instagram Business Account ID
  displayName        String?
  accessTokenEncrypted String // encrypted at rest, per the blueprint's Level 8 "non-negotiable" security note
  tokenExpiresAt     DateTime?
  audienceProfile    Json?    // Audience Agent config: {businessSummary, targetAudience, brandVoice?, goals?} -- set via the dashboard, advisory only
  posts              SocialPost[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([platform])
}

model SocialPost {
  id                 String           @id @default(cuid())
  accountId          String
  account            SocialAccount    @relation(fields: [accountId], references: [id])
  topic              String           // the human-entered brief the Content Creation Agent drafted from
  mediaType          MediaType        @default(IMAGE)
  mediaUrl           String           // publicly-reachable image/video URL -- Instagram's Content Publishing API requires real media
  videoAgentProductionId String?      // set when mediaUrl was imported from the separate Video Agent product, for traceability
  caption            String
  status             SocialPostStatus @default(DRAFT)
  complianceVerdict  Json?            // Compliance Agent's structured reasoning, always recorded even when it passes
  trendContext       Json?            // Trend Agent's suggestion at draft time (advisory, never blocks) -- TrendSuggestion shape
  audienceContext    Json?            // Audience Agent's guidance at draft time (advisory, never blocks) -- AudienceGuidance shape
  externalMediaId    String?          // Instagram media ID once actually published
  publishedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  performanceSnapshots PostPerformance[]

  @@index([status])
  @@index([accountId])
}

// Analytics Agent snapshots -- one row per "Refresh analytics" click, kept as
// a history (not upserted) so the Learning Loop can see trends over time,
// not just the latest number.
model PostPerformance {
  id                String     @id @default(cuid())
  postId            String
  post              SocialPost @relation(fields: [postId], references: [id])
  fetchedAt         DateTime   @default(now())
  likeCount         Int?
  commentsCount     Int?
  savedCount        Int?
  sharesCount       Int?
  reach             Int?
  totalInteractions Int?
  raw               Json       // every metric Meta actually returned, unfiltered
  unavailableFields String[]   @default([]) // metrics that were rejected/unsupported for this media type

  @@index([postId])
  @@index([postId, fetchedAt])
}

// Mirrors sbai-systems' own AuditLog model exactly, for consistency across
// both projects -- every agent decision and every human action logged here.
model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String?  // null when the actor is an agent, not a human
  action     String
  entity     String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
}
