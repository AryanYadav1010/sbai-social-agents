# Database (Postgres, e.g. Neon) -- run `npx prisma migrate deploy` once set
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# NextAuth (admin login, Google OAuth -- same pattern as sbai-systems)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate with: openssl rand -hex 32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ADMIN_EMAILS="you@example.com"

# Meta app (Instagram publishing) -- Meta for Developers > your app > Settings > Basic
META_APP_ID=""
META_APP_SECRET=""

# TikTok app (TikTok publishing, Content Posting API / Direct Post) --
# TikTok for Developers > your app > Basic Information. App must have the
# "Content Posting API" product added and the redirect URI
# https://<your-domain>/api/tiktok/callback registered under it.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# X (Twitter) app (X publishing) -- developer.x.com > your app > Keys and
# tokens > OAuth 2.0 Client ID and Client Secret. App must have OAuth 2.0
# enabled with "Read and write" permissions, and the redirect URI
# https://<your-domain>/api/x/callback registered under it.
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Content Creation + Compliance agents (Anthropic)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Token encryption (OAuth tokens encrypted at rest) -- generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# Video Agent (separate product -- generates short videos) -- base URL of its
# deployed backend. Optional: only needed to use "Video Agent production" as
# a post's media source instead of a manual URL.
VIDEO_AGENT_BASE_URL=""

# Vercel Blob (direct file upload as a post's media source) -- Vercel
# dashboard > this project > Storage > connect/create a Blob store, which
# adds this automatically. Not needed for the URL or Video Agent sources.
BLOB_READ_WRITE_TOKEN=""

# --- Always-on worker (see docs/always-on-worker.md) ---------------------

# A DIRECT (non-pooled) Postgres connection for the worker process, e.g.
# Neon's non "-pooler" host. Graphile Worker relies on LISTEN/NOTIFY, which
# a PgBouncer transaction-pooling endpoint (the usual Neon "-pooler" URL,
# and what DATABASE_URL above normally is) breaks. Falls back to
# DATABASE_URL if unset, which *works* but is not recommended for
# production -- see the docs for why.
WORKER_DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# How many jobs the worker runs concurrently. Protects Anthropic/platform
# rate limits and stops one account's backlog from starving everyone else.
WORKER_CONCURRENCY=4

# How often (seconds) each worker node writes its heartbeat -- also used
# to derive the "stale" threshold (3 missed heartbeats) the dashboard and
# maintenance task use to decide a node has gone offline.
WORKER_HEARTBEAT_SECONDS=30

# Optional friendly name for this machine in the dashboard's worker list.
# Defaults to the OS hostname if unset.
WORKER_NODE_NAME=""

# Hard safety gate for fully-automatic publishing (no human approval
# click). Defaults to false/unset -- MUST be explicitly set to the literal
# string "true" for any account's requireApproval=false setting to have
# effect at all. Per-account opt-in (via the Automation page) is the
# second, independent gate; both must allow it.
ENABLE_AUTONOMOUS_PUBLISH="false"
